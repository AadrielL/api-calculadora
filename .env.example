# ===============================================
# Variaveis de Ambiente - API Calculadora (Porta 8081)
# ===============================================
# Copie este arquivo para .env e preencha com seus valores reais.
# NUNCA envie o arquivo .env com credenciais reais para o Git!

# Segredo de Assinatura JWT (DEVE ser IDENTICO ao da api_auth)
JWT_SECRET=seu_segredo_jwt_super_secreto_aqui

# Banco de Dados PostgreSQL
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=1234
JPA_DDL=update
